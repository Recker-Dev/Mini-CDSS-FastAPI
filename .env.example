# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env

# ---- Local LLM (required) -------------------------------------------------
# OpenAI-compatible endpoint used when running the app directly (uv run).
LOCAL_LLM_BASE_URL=http://localhost:55555/v1
LOCAL_LLM_MODEL=qwen3.5
LOCAL_LLM_API_KEY=changeme
# Safety ceilings (not tight caps). Raise if you ever see truncation errors.
LOCAL_LLM_MAX_TOKENS=3072
LOCAL_LLM_STRUCTURED_MAX_TOKENS=4096

# ---- Optional remote services ---------------------------------------------
TAVILY_API_KEY=
# HF_TOKEN=

# ---- Frontend -------------------------------------------------------------
# Backend origin the Streamlit app calls when running directly (uv run).
BACKEND_URL=http://localhost:8000

# ---- Docker wiring (compose ${...} interpolation) -------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8501
# Internal origins used inside the compose networks (service-name based).
LLM_BASE_URL_DOCKER=http://<llm-service-name>:<port>/v1
BACKEND_URL_DOCKER=http://minicdss-backend:8000
# Names of the external docker networks to attach to.
APP_NET=<your-app-network>
LLM_NET=<your-llm-network>
